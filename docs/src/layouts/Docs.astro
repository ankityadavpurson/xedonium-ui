---
import latinFont from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url'
import '../main.css'
import { getThemeInitScript } from '@xedonium-src/theme/initScript'
import { DEFAULT_DESCRIPTION, SITE } from '../seo.js'

interface Props {
	title?: string
	description?: string
	/** Absolute URL of the page; omitted for pages search engines should skip (they get `noindex`). */
	canonical?: string
}

const { title = '', description = DEFAULT_DESCRIPTION, canonical } = Astro.props
const heading = title ? `${title} · Xedonium` : 'Xedonium'
const socialTitle = title ? heading : 'Xedonium: minimal, theme-aware React UI'
const image = `${SITE}/social-preview-dark.png`
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<!-- Sets data-theme before the first paint (the prerendered HTML cannot know the visitor's theme), so a dark visitor
		     never sees the light page; must match the ThemeProvider in DocsRoot.jsx -->
		<script is:inline set:html={getThemeInitScript({ storageKey: 'xedonium-docs-theme' })} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{heading}</title>
		<meta name="description" content={description} />
		{canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<!-- Link previews (Slack, X, LinkedIn, ...). The image URL has to be absolute; swap -dark for the light card if you prefer it. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Xedonium" />
		<meta property="og:title" content={socialTitle} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta property="og:image:alt" content="Xedonium: minimal, theme-aware React UI" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={socialTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<!-- Archivo is served from this site (@fontsource-variable, see main.css); preloading the Latin file starts the
		     download with the page, so text is not shown in the fallback font first -->
		<link rel="preload" as="font" type="font/woff2" href={latinFont} crossorigin />
		<!-- Static fan icon for first paint; ThemeProvider swaps in the theme-matched one -->
		<link id="app-favicon" rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Catalog of what AI agents can use here (Agentic Resource Discovery); also served at /.well-known/ai-catalog.json -->
		<link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
	</head>
	<body>
		<slot />
		<script>
			import { clearChunkReloadGuard, reloadOnStaleChunk } from '../reloadOnStaleChunk'

			// A chunk from an older deploy is gone: reload once to get the current build
			window.addEventListener('vite:preloadError', event => {
				if (reloadOnStaleChunk(event.payload ?? 'Failed to fetch dynamically imported module')) event.preventDefault()
			})
			window.addEventListener('load', () => setTimeout(clearChunkReloadGuard, 5000))
		</script>
	</body>
</html>
