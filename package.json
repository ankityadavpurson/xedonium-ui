{
	"name": "xedonium",
	"version": "0.1.0",
	"description": "Minimal, theme-aware React + Tailwind UI components extracted from Boot Bridge",
	"type": "module",
	"license": "MIT",
	"author": "Ankit Yadav",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ankityadavpurson/xedonium-ui.git"
	},
	"bugs": {
		"url": "https://github.com/ankityadavpurson/xedonium-ui/issues"
	},
	"homepage": "https://github.com/ankityadavpurson/xedonium-ui#readme",
	"keywords": [
		"react",
		"tailwind",
		"tailwindcss",
		"ui",
		"components"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist",
		"tailwind-preset.js"
	],
	"main": "./dist/xedonium.cjs",
	"module": "./dist/xedonium.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/xedonium.js",
			"require": "./dist/xedonium.cjs"
		},
		"./styles.css": "./dist/styles.css",
		"./tailwind-preset": "./tailwind-preset.js"
	},
	"scripts": {
		"docs": "vite --config docs/vite.config.js",
		"build": "vite build && npm run build:types && node scripts/copy-css.js",
		"build:types": "tsc -p tsconfig.build.json",
		"lint": "eslint .",
		"docs:build": "vite build --config docs/vite.config.js && node scripts/spa-fallback.mjs",
		"docs:preview": "vite preview --config docs/vite.config.js",
		"docs:check": "node scripts/check-docs.mjs",
		"prepublishOnly": "npm run lint && npm run build",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"tailwindcss": "^3.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^9",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^14",
		"@testing-library/user-event": "^14.6.7",
		"@types/react": "^18.2.0",
		"@vitejs/plugin-react": "^4.2.1",
		"@vitest/coverage-v8": "^2",
		"autoprefixer": "^10.4.19",
		"eslint": "^9",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.5",
		"postcss": "^8.4.38",
		"prettier": "^3.9.9",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6",
		"tailwindcss": "^3.4.3",
		"typescript": "^5.4.0",
		"vite": "^5.2.0",
		"vitest": "^2"
	}
}
