{
	"name": "xedonium",
	"version": "0.1.0",
	"description": "Minimal, theme-aware React + Tailwind UI components extracted from Boot Bridge",
	"type": "module",
	"license": "MIT",
	"author": "Ankit Yadav",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ankityadavpurson/xedonium-ui.git"
	},
	"bugs": {
		"url": "https://github.com/ankityadavpurson/xedonium-ui/issues"
	},
	"homepage": "https://github.com/ankityadavpurson/xedonium-ui#readme",
	"keywords": [
		"react",
		"tailwind",
		"tailwindcss",
		"ui",
		"components"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist",
		"tailwind-preset.js"
	],
	"main": "./dist/xedonium.cjs",
	"module": "./dist/xedonium.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/xedonium.js",
			"require": "./dist/xedonium.cjs"
		},
		"./styles.css": "./dist/styles.css",
		"./tailwind-preset": "./tailwind-preset.js"
	},
	"scripts": {
		"dev": "vite --config playground/vite.config.js",
		"build": "vite build && npm run build:types && node scripts/copy-css.js",
		"build:types": "tsc -p tsconfig.build.json",
		"lint": "eslint .",
		"prepublishOnly": "npm run lint && npm run build",
		"docs": "yarn --cwd docs start",
		"docs:build": "yarn --cwd docs build",
		"format": "prettier --write ."
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"tailwindcss": "^3.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^9",
		"@types/react": "^18.2.0",
		"@vitejs/plugin-react": "^4.2.1",
		"autoprefixer": "^10.4.19",
		"eslint": "^9",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5",
		"globals": "^17.12.0",
		"postcss": "^8.4.38",
		"prettier": "^3.9.9",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"tailwindcss": "^3.4.3",
		"typescript": "^5.4.0",
		"vite": "^5.2.0"
	}
}
